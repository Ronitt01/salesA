# HUNTER environment template.
# Copy to .env.local and fill in. Never commit .env.local.
# Only variables prefixed NEXT_PUBLIC_ are ever sent to the browser.

# --- Supabase ---------------------------------------------------------------
# Local stack: run `npm run db:start`, then `npm run db:status` prints these values.
# HUNTER's local stack uses ports 55321-55329 so it can run beside other Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. Used by the seed script, webhook
# ingestion and the workflow runner. Must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo mode --------------------------------------------------------------
# "true" shows the "Sign in as demo user" button and the demo-data controls.
# Set to "false" in production.
NEXT_PUBLIC_DEMO_MODE=true
DEMO_USER_EMAIL=demo@hunter.local
DEMO_USER_PASSWORD=

# --- Application ------------------------------------------------------------
APP_URL=http://localhost:3000

# --- AI provider ------------------------------------------------------------
# mock | anthropic | gemini. "mock" (the default) is deterministic, needs no key, and
# every result it produces is recorded as synthetic. "openai" is reserved but not built.
# Switching provider is only a matter of these variables. A misconfigured provider
# fails loudly; HUNTER never falls back to the mock or to another provider.
LLM_PROVIDER=mock
# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=
# Server only. A Gemini Developer API key. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash when empty.
GEMINI_MODEL=gemini-3.8-flash
# Limits for each AI call. Defaults shown.
LLM_TIMEOUT_MS=120000
LLM_TOTAL_TIMEOUT_MS=300000
LLM_MAX_ATTEMPTS=3
LLM_MAX_RETRY_DELAY_MS=30000

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Outbound safety --------------------------------------------------------
# Live sending is impossible unless this is "true" AND the compliance gate passes
# AND a real delivery provider is configured. Leave "false" during development.
OUTBOUND_LIVE_SENDING=false

# --- n8n --------------------------------------------------------------------
# Leave empty to run workflows in the labelled local simulation mode.
N8N_BASE_URL=
# Shared secret used to sign and verify webhooks between HUNTER and n8n (HMAC-SHA256).
N8N_WEBHOOK_SECRET=
